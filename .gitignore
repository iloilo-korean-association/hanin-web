# 의존성
/node_modules
/.pnp
.pnp.*

# Next.js
/.next/
/out/
next-env.d.ts

# 빌드 산출물
/build
*.tsbuildinfo

# 환경변수 — .env 는 로컬 프로토타입용 개발 시크릿이 들어 있으므로 커밋하지 않는다.
# .env.example 만 커밋한다.
# .env 로 시작하는 것은 전부 제외한다. .env.example 만 예외.
# (예전에는 .env / .env.local / .env.*.local 세 줄만 있어서 .env.bak 같은 백업 파일이
#  그물을 빠져나갔다. 실제로 커밋 직전에 잡혔다. 확장자를 하나씩 나열하는 방식은 진다.)
.env
.env.*
!.env.example

# SQLite 원장 파일. 실제 회계 데이터가 들어가는 순간 절대 커밋하면 안 된다
# (회원 이름·연락처 = 개인정보. 필리핀 DPA RA10173 / 한국 PIPA).
/prisma/*.db
/prisma/*.db-journal
/prisma/*.sqlite
/prisma/migrations/dev.db*

# 업로드된 증빙(영수증 사진 등)
/public/uploads/
/public/members/

# 실데이터 원본(엑셀 장부 등) — 실명·금액이 든 파일은 어떤 확장자든 커밋 금지.
# 원본 보관 위치는 저장소 밖 `../09_원본데이터/`, 시스템 반입은 비공개 Blob 업로드로만.
*.xlsx
*.xls
*.csv

# OS / 편집기
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# 로그
npm-debug.log*
yarn-debug.log*
yarn-error.log*

.vercel
.env*

# ★ 위쪽 .env* 규칙보다 뒤에 와야 효력이 있다 (gitignore 는 나중 규칙이 이긴다).
#   Vercel CLI 가 link 할 때 .env* 를 자동 추가하는데, 그게 예외를 덮어쓴다.
!.env.example
